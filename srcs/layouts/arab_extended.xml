<?xml version="1.0" encoding="utf-8"?>
<!-- ڤ ڨ گ پ ژ چ are on a bottom diagonal swipe of their base letter.
     Shift gives the extra letters used in Persian, Urdu, Kurdish and
     Maghrebi Arabic (پ چ ژ ڤ گ ...). Harakat are on the bottom-left swipe of
     the second row. -->
<keyboard name="Arabic Extended" script="arabic">
  <modmap>
    <shift a="ق" b="ڨ"/>
    <shift a="ف" b="ڤ"/>
    <shift a="ه" b="ھ"/>
    <shift a="ج" b="چ"/>
    <shift a="د" b="ڈ"/>
    <shift a="ي" b="ی"/>
    <shift a="ب" b="پ"/>
    <shift a="ل" b="ڵ"/>
    <shift a="ت" b="ٹ"/>
    <shift a="ن" b="ں"/>
    <shift a="ك" b="ک"/>
    <shift a="ر" b="ڑ"/>
    <shift a="ى" b="ے"/>
    <shift a="ة" b="ە"/>
    <shift a="و" b="ۇ"/>
    <shift a="ؤ" b="ۆ"/>
    <shift a="ز" b="ژ"/>
  </modmap>
  <row>
    <key c="ض" ne="1" se="!"/>
    <key c="ص" ne="2" se="\@"/>
    <key c="ث" ne="3" se="\#"/>
    <key c="ق" ne="4" w="$" sw="ڨ"/>
    <key c="ف" ne="5" nw="٪" w="%" sw="ڤ"/>
    <key c="غ" ne="6" se="^"/>
    <key c="ع" ne="7" se="&amp;"/>
    <key c="ه" ne="8" se="*" w="ہ"/>
    <key c="خ" ne="9" se="("/>
    <key c="ح" ne="0" se=")"/>
    <key c="ج" ne="-" w="_" sw="چ"/>
    <key c="د" ne="=" se="+"/>
  </row>
  <row>
    <key c="ذ" sw="َ"/>
    <key c="ش" sw="ُ"/>
    <key c="س" sw="ِ"/>
    <key c="ي" nw="ئ" ne="[" w="ێ" sw="ْ"/>
    <key c="ب" ne="]" sw="ّ" se="پ"/>
    <key c="ل" sw="ً"/>
    <key c="ا" nw="أ" ne="إ" w="آ" sw="ٌ"/>
    <key c="ت" n="ـ" sw="ٍ"/>
    <key c="ن" nw="&lt;" ne="&gt;" sw="ٰ"/>
    <key c="م" ne="/" se="\?" sw="ٓ"/>
    <key c="ك" ne="ڭ" nw=":" se="گ"/>
    <key c="ط" ne="'" se="&quot;"/>
  </row>
  <row>
    <key width="1.5" role="action" c="shift" n="loc capslock"/>
    <key c="ء" nw="~" ne="`"/>
    <key c="ؤ" ne="{"/>
    <key c="ر" ne="}" s="ڕ"/>
    <key c="لا" nw="لأ" ne="لإ" w="لآ"/>
    <key c="ى" ne="\\"/>
    <key c="ة" ne="|"/>
    <key c="و" ne="،" se="," nw=";"/>
    <key c="ز" ne="." nw="٫" e="٬" sw="ژ"/>
    <key c="ظ" ne="؟" se="؛" w="«" e="»"/>
    <key width="1.5" role="action" c="backspace" n="delete"/>
  </row>
</keyboard>
