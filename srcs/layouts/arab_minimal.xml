    <key width="1.67" c="ج" n="خ" e="ح" s="چ" sw="ّ"/>
    <key width="1.67" c="د" n="ذ" s="ڈ" ne="\\" se="|" sw="ٰ"/>
  </row>
  <row>
    <key width="1.67" c="س" n="ش" ne="'" se="&quot;" sw="ً"/>
    <key width="1.67" c="ي" n="ئ" e="ى" s="ی" w="ێ" nw="ے" sw="ٌ"/>
    <key width="1.67" c="ب" n="ت" ne="ث" nw="ن" s="پ" e="ٹ" sw="ٍ"/>
    <key width="1.67" c="ل" n="لا" ne="لأ" nw="لإ" w="لآ" s="ڵ" sw="ٓ"/>
    <key width="1.67" c="ا" n="أ" ne="إ" w="آ" s="ء" sw="ٱ"/>
    <key width="1.67" c="ك" n="گ" nw="ک" ne="ڭ"/>
  </row>
  <row>
    <key width="1.67" c="ر" n="ز" ne="ژ" s="ڕ" e="ڑ"/>
    <key width="1.67" c="و" n="ؤ" s="ۆ" e="ۇ"/>
    <key width="1.67" c="ط" n="ظ" ne="{" se="}"/>
    <key width="1.67" c="م" ne="/" se="\?" nw=":"/>
    <key width="1.67" c="،" nw=";" n="؟" ne="؛" e="." w="," s="ـ"/>
    <key width="1.67" role="action" c="backspace" n="delete"/>
  </row>
</keyboard>
