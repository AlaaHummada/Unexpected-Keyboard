<?xml version="1.0" encoding="utf-8"?>
<keyboard name="Arabic Minimal" script="arabic">
  <row>
    <key c="1" s="!" n="-"/>
    <key c="2" s="\@" n="_"/>
    <key c="3" s="\#" n="="/>
    <key c="4" s="$" n="+"/>
    <key c="5" s="%" n="٪"/>
    <key c="6" s="^" n="٫"/>
    <key c="7" s="&amp;" n="٬"/>
    <key c="8" s="*" n="«" ne="»"/>
    <key c="9" s="(" n="&lt;"/>
    <key c="0" s=")" n="&gt;"/>
  </row>
  <row>
    <key width="1.67" c="ص" n="ض" ne="[" se="]" sw="َ"/>
    <key width="1.67" c="ف" n="ق" s="ڤ" ne="ڨ" sw="ُ"/>
    <key width="1.67" c="ع" n="غ" ne="~" se="`" sw="ِ"/>
